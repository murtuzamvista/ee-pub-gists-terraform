{
  "argocd_applications": {
    "qa": {
      "name": "ee-pub-gists-qa",
      "namespace": "argocd",
      "finalizers": [
        "resources-finalizer.argocd.argoproj.io"
      ],
      "project": "default",
      "gitops": {
        "repository": "https://github.com/murtuzamvista/ee-pub-gists-gitops.git",
        "revision": "main",
        "path": "overlays/qa"
      },
      "destination": {
        "server": "https://kubernetes.default.svc",
        "namespace": "ee-pub-gists-qa"
      },
      "automated_sync": true,
      "prune": true,
      "self_heal": true
    }
  }
}
