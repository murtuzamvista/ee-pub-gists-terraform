{
  "argocd_namespace": "argocd",
  "argocd_applications": {
    "dev": {
      "name": "dev",
      "finalizers": [
        "resources-finalizer.argocd.argoproj.io"
      ],
      "project": "default",
      "gitops": {
        "repository": "https://github.com/murtuzamvista/ee-pub-gists-gitops.git",
        "revision": "main",
        "path": "overlays/dev"
      },
      "destination": {
        "server": "https://kubernetes.default.svc",
        "namespace": "dev"
      },
      "automated_sync": true,
      "prune": true,
      "self_heal": true
    }
  }
}
